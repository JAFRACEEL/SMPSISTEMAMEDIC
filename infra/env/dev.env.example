# SISTEMAMEDIC - variables de DEV local. Solo NOMBRES y valores de ejemplo.
# Esta es la ÚNICA plantilla (no existe /.env.example): path_guard protege .env* en la raíz.
# Uso: copiar a .env en la raíz del repositorio (ignorado por git) y completar.
# Nunca valores reales. Solo datos sintéticos (docs/TEST_DATA_POLICY.md).

# --- PostgreSQL (lo usa el contenedor postgres y se compone SMD_DATABASE_URL) ---
POSTGRES_DB=sistemamedic_dev
POSTGRES_USER=sm_dev
# Obligatorio: el compose falla si está vacío. Usar solo letras y números: se inserta en una URL.
POSTGRES_PASSWORD=

# --- Backend (prefijo SMD_, ver backend/app/core/config.py) ---
# Secreto de sesiones/JWT de DEV: generar uno aleatorio local. Obligatorio en el compose.
SMD_SECRET_KEY=
SMD_ENVIRONMENT=dev
SMD_LOG_LEVEL=INFO
# SMD_DATABASE_URL lo arma docker-compose.yml a partir de POSTGRES_*; no se define aquí.
# Opcional: orígenes CORS (lista JSON). Por defecto solo el servidor de Vite en :5173.
# SMD_CORS_ORIGINS=["http://localhost:5173"]

# --- Puertos del host (no privilegiados, solo 127.0.0.1) ---
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Frontend ---
# Por defecto el cliente usa /api (proxy de Vite). Definir solo si se aloja la API en otro origen
# (entonces debe terminar en /api y el origen debe estar en SMD_CORS_ORIGINS).
# VITE_API_BASE_URL=http://localhost:8000/api
