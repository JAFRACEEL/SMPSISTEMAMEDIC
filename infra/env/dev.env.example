# SISTEMAMEDIC - variables de DEV local. Solo NOMBRES y valores de ejemplo.
# Ubicación provisional: path_guard bloquea .env.example en la raíz para 'devops'.
# Un humano (o el agente autorizado) debe copiarlo a la raíz como .env.example.
# Uso: copiar a .env en la raíz (ignorado por git) y completar. Nunca valores reales.
# Solo datos sintéticos (docs/TEST_DATA_POLICY.md).

POSTGRES_DB=sistemamedic_dev
POSTGRES_USER=sm_dev
# Obligatorio: el compose falla si está vacío.
POSTGRES_PASSWORD=
# Secreto de sesiones/JWT de DEV: generar uno aleatorio local.
APP_SECRET_KEY=

APP_ENV=dev
LOG_LEVEL=INFO

# Puertos del host (no privilegiados, solo 127.0.0.1)
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

VITE_API_BASE_URL=http://localhost:8000
