# Imagen de backend SOLO DEV. Contexto de build: raíz del repositorio.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN useradd --create-home --uid 10001 app
WORKDIR /app

# Supuesto: backend/pyproject.toml define dependencias y extra opcional "dev".
COPY backend/ /app/
RUN pip install -e ".[dev]"

USER app
EXPOSE 8000
# Supuesto: módulo app.main expone `app` (FastAPI).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
